// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — ROCSAUT Club Platform
//
// 資料庫：PostgreSQL（Supabase）
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  EXEC
  MEMBER
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskGroupStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskGroupRole {
  LEADER
  MEMBER
}

enum FinanceType {
  INCOME
  EXPENSE
}

// ─────────────────────────────────────────────────────────────────────────────
// User / NextAuth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  image         String?
  emailVerified DateTime?
  role          Role      @default(MEMBER)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  bio         String?
  major       String?
  rocsautYear Int?
  instagram   String?
  linkedin    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  registrations     Registration[]
  assignedTasks     Task[]           @relation("TaskAssignee")
  taskAssignments   TaskAssignee[]
  comments          Comment[]
  announcements    Announcement[]
  announcementReads AnnouncementRead[]
  taskGroups        TaskGroupMember[]
  createdTaskGroups TaskGroup[]      @relation("TaskGroupCreator")
  createdVotes      Vote[]           @relation("VoteCreator")
  voteResponses     VoteResponse[]
  financeRecords    FinanceRecord[]  @relation("FinanceRecordCreator")
  pushSubscriptions PushSubscription[]
  taskViews         TaskView[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members User[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Events
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  location    String?
  capacity    Int?
  imageUrl    String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  registrations     Registration[]
  discussion        Discussion?
  tickets           EventTicket[]
  ticketTiers       TicketTier[]
  memberRedemptions MemberRedemption[]
}

model Registration {
  id      String             @id @default(cuid())
  userId  String
  user    User               @relation(fields: [userId], references: [id])
  eventId String
  event   Event              @relation(fields: [eventId], references: [id])
  status  RegistrationStatus @default(REGISTERED)
  attendedAt DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, eventId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Halloween Ticketing
// ─────────────────────────────────────────────────────────────────────────────

/// Ticket tier configuration.
/// Price and Stripe Price ID are controlled by the backend/database,
/// not by the public frontend.
model TicketTier {
  id             String   @id @default(cuid()) @map("id")
  eventId        String   @map("event_id")
  tier           String
  price          Decimal  @db.Decimal(10, 2)
  stripePriceId  String   @map("stripe_price_id")
  capacity       Int
  salesCloseAt   DateTime @map("sales_close_at")
  createdAt      DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, tier])
  @@index([eventId])
  @@map("TicketTier")
}

/// Final ticket record.
/// Created only after Stripe webhook confirms successful payment.
model EventTicket {
  id       String @id @default(cuid())
  eventId  String @map("event_id")

  token String @unique

  name  String
  email String
  phone String

  tier      String
  price     Decimal @db.Decimal(10, 2)
  isMember  Boolean @default(false) @map("is_member")
  memberId  String? @map("member_id")

  stripeSessionId String @unique @map("stripe_session_id")

  status String @default("valid")

  waiverAcceptedAt DateTime? @map("waiver_accepted_at")
  waiverVersion    String?   @map("waiver_version")

  ageConfirmedAt DateTime? @map("age_confirmed_at")

  checkedIn   Boolean   @default(false) @map("checked_in")
  checkedInAt DateTime? @map("checked_in_at")

  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([memberId])
  @@index([email])
  @@map("EventTicket")
}

/// Prevents the same member from using member pricing
/// more than once for the same event.
model MemberRedemption {
  id       String @id @default(cuid())
  memberId String @map("member_id")
  eventId  String @map("event_id")

  status String @default("pending")

  stripeSessionId String? @unique @map("stripe_session_id")
  lockedAt        DateTime? @map("locked_at")

  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([memberId, eventId])
  @@index([eventId])
  @@index([memberId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Discussions
// ─────────────────────────────────────────────────────────────────────────────

model Discussion {
  id          String   @id @default(cuid())
  eventId     String?  @unique
  event       Event?   @relation(fields: [eventId], references: [id])
  taskGroupId String?
  taskGroup   TaskGroup? @relation(fields: [taskGroupId], references: [id])
  createdAt   DateTime @default(now())

  comments Comment[]
}

model Comment {
  id           String      @id @default(cuid())
  discussionId String
  discussion   Discussion  @relation(fields: [discussionId], references: [id])
  authorId     String?
  author       User?       @relation(fields: [authorId], references: [id])
  content      String
  isAnonymous  Boolean     @default(false)
  createdAt    DateTime    @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Announcements
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id        String             @id @default(cuid())
  title     String
  content   String
  published Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  authorId  String
  author    User               @relation(fields: [authorId], references: [id])
  reads     AnnouncementRead[]
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Task Groups
// ─────────────────────────────────────────────────────────────────────────────

model TaskGroup {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      TaskGroupStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdById String
  createdBy   User @relation("TaskGroupCreator", fields: [createdById], references: [id])

  members     TaskGroupMember[]
  tasks       Task[]
  discussions Discussion[]
  votes       Vote[]
}

model TaskGroupMember {
  id          String        @id @default(cuid())
  taskGroupId String
  taskGroup   TaskGroup     @relation(fields: [taskGroupId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  role        TaskGroupRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  @@unique([taskGroupId, userId])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?

  taskGroupId String
  taskGroup   TaskGroup @relation(fields: [taskGroupId], references: [id])

  assigneeId String?
  assignee   User? @relation("TaskAssignee", fields: [assigneeId], references: [id])

  assignees TaskAssignee[]

  status TaskStatus @default(TODO)
  dueAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  views TaskView[]
}

model TaskAssignee {
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([taskId, userId])
}

model TaskView {
  id       String   @id @default(cuid())
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([taskId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Voting
// ─────────────────────────────────────────────────────────────────────────────

model Vote {
  id          String    @id @default(cuid())
  title       String
  description String?
  taskGroupId String
  taskGroup   TaskGroup @relation(fields: [taskGroupId], references: [id])

  createdById String
  createdBy   User @relation("VoteCreator", fields: [createdById], references: [id])

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  options VoteOption[]
}

model VoteOption {
  id     String @id @default(cuid())
  voteId String
  vote   Vote   @relation(fields: [voteId], references: [id])
  label  String

  responses VoteResponse[]
}

model VoteResponse {
  id           String @id @default(cuid())
  voteOptionId String
  voteOption   VoteOption @relation(fields: [voteOptionId], references: [id])
  userId       String
  user         User @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([voteOptionId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Sponsors
// ─────────────────────────────────────────────────────────────────────────────

model Sponsor {
  id          String           @id @default(cuid())
  name        String
  logoUrl     String?
  website     String?
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  histories SponsorHistory[]
}

model SponsorHistory {
  id        String   @id @default(cuid())
  sponsorId String
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  year      Int
  tier      String
  createdAt DateTime @default(now())

  @@unique([sponsorId, year])
}

// ─────────────────────────────────────────────────────────────────────────────
// Site / Content
// ─────────────────────────────────────────────────────────────────────────────

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  year        Int
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Alumni {
  id             String   @id @default(cuid())
  name           String
  graduationYear Int?
  position       String?
  department     String?
  bio            String?
  linkedinUrl    String?
  instagramUrl   String?
  photoUrl       String?
  isPublic       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Finance
// ─────────────────────────────────────────────────────────────────────────────

model FinanceRecord {
  id          String      @id @default(cuid())
  type        FinanceType
  amount      Decimal     @db.Decimal(12, 2)
  currency    String      @default("CAD")
  category    String
  description String?
  date        DateTime

  createdById String
  createdBy   User @relation("FinanceRecordCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Budget {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("CAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, category])
}

// ─────────────────────────────────────────────────────────────────────────────
// Configuration / Email / Push
// ─────────────────────────────────────────────────────────────────────────────

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  key       String   @id
  subject   String
  body      String   @db.Text
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String?  @unique
  p256dh    String?
  auth      String?
  expoToken String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// ROCSAUT Membership
// ─────────────────────────────────────────────────────────────────────────────

model ROCSAUT_Membership_Info {
  id             String    @id @db.Uuid
  member_code    String
  name           String?
  email          String?
  personal_email  String?
  student_number String?
  created_at     DateTime? @db.Timestamptz(6)
  year_of_study  String?
  role           String?

  @@map("ROCSAUT Membership Info")
}