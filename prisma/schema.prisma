// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — ROCSAUT Club Platform
//
// 資料庫：PostgreSQL（Supabase）
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  EXEC
  MEMBER
  /// Signed up but no active membership (before paying, or after a term ends).
  USER
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskGroupStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskGroupRole {
  LEADER
  MEMBER
}

enum FinanceType {
  INCOME
  EXPENSE
}

// ─────────────────────────────────────────────────────────────────────────────
// User / NextAuth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  image         String?
  emailVerified DateTime?
  role          Role      @default(USER)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  bio         String?
  major       String?
  rocsautYear Int?
  instagram   String?
  linkedin    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  registrations      Registration[]
  assignedTasks      Task[]             @relation("TaskAssignee")
  taskAssignments    TaskAssignee[]
  comments           Comment[]
  announcements      Announcement[]
  announcementReads  AnnouncementRead[]
  taskGroups         TaskGroupMember[]
  createdTaskGroups  TaskGroup[]        @relation("TaskGroupCreator")
  createdVotes       Vote[]             @relation("VoteCreator")
  voteResponses      VoteResponse[]
  financeRecords     FinanceRecord[]    @relation("FinanceRecordCreator")
  pushSubscriptions  PushSubscription[]
  taskViews          TaskView[]
  orders             Order[]
  heldTickets        Ticket[]           @relation("TicketHolder")
  checkedInTickets   Ticket[]           @relation("TicketCheckedInBy")
  profile            Profile?
  memberships        Membership[]
  groupMemberships   GroupMember[]
  approvalRequests   ApprovalRequest[]  @relation("ApprovalRequester")
  approvalDecisions  ApprovalRequest[]  @relation("ApprovalDecider")
  financeSubmissions EventSettings[]    @relation("FinanceSubmittedBy")
  financeReviews     EventSettings[]    @relation("FinanceReviewedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members User[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Events
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  location    String?
  capacity    Int?
  imageUrl    String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  registrations     Registration[]
  discussion        Discussion?
  tickets           EventTicket[]
  ticketTiers       TicketTier[]
  memberRedemptions MemberRedemption[]

  settings       EventSettings?
  ticketTypes    TicketType[]
  orders         Order[]
  entryTickets   Ticket[]
  team           Group?
  budgetLines    EventBudgetLine[]
  financeRecords FinanceRecord[]
}

model Registration {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id])
  eventId    String
  event      Event              @relation(fields: [eventId], references: [id])
  status     RegistrationStatus @default(REGISTERED)
  attendedAt DateTime?
  createdAt  DateTime           @default(now())

  @@unique([userId, eventId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Halloween Ticketing
// ─────────────────────────────────────────────────────────────────────────────

/// Ticket tier configuration.
/// Price and Stripe Price ID are controlled by the backend/database,
/// not by the public frontend.
model TicketTier {
  id            String   @id @default(cuid()) @map("id")
  eventId       String   @map("event_id")
  tier          String
  price         Decimal  @db.Decimal(10, 2)
  stripePriceId String   @map("stripe_price_id")
  capacity      Int
  salesCloseAt  DateTime @map("sales_close_at")
  createdAt     DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, tier])
  @@index([eventId])
  @@map("TicketTier")
}

/// Final ticket record.
/// Created only after Stripe webhook confirms successful payment.
model EventTicket {
  id      String @id @default(cuid())
  eventId String @map("event_id")

  token String @unique

  name  String
  email String
  phone String

  tier     String
  price    Decimal @db.Decimal(10, 2)
  isMember Boolean @default(false) @map("is_member")
  memberId String? @map("member_id")

  stripeSessionId String @unique @map("stripe_session_id")

  status String @default("valid")

  waiverAcceptedAt DateTime? @map("waiver_accepted_at")
  waiverVersion    String?   @map("waiver_version")

  ageConfirmedAt DateTime? @map("age_confirmed_at")

  checkedIn   Boolean   @default(false) @map("checked_in")
  checkedInAt DateTime? @map("checked_in_at")

  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([memberId])
  @@index([email])
  @@map("EventTicket")
}

/// Prevents the same member from using member pricing
/// more than once for the same event.
model MemberRedemption {
  id       String @id @default(cuid())
  memberId String @map("member_id")
  eventId  String @map("event_id")

  status String @default("pending")

  stripeSessionId String?   @unique @map("stripe_session_id")
  lockedAt        DateTime? @map("locked_at")

  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([memberId, eventId])
  @@index([eventId])
  @@index([memberId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Event Ticketing (all events after Halloween 2026)
//
// Halloween keeps using TicketTier / EventTicket / MemberRedemption above;
// those tables are frozen. New events use the tables below.
// ─────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  FREE
  EXPIRED
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  RESERVED
  VALID
  VOID
}

/// Per-event settings that the Event table does not hold.
model EventSettings {
  id      String @id @default(cuid())
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// IANA zone used to display this event's times, e.g. "Asia/Taipei".
  timezone String @default("America/Toronto")
  currency String @default("CAD")

  registrationEnabled Boolean @default(false)
  ticketsEnabled      Boolean @default(false)
  checkInEnabled      Boolean @default(false)
  budgetEnabled       Boolean @default(false)
  dashboardEnabled    Boolean @default(false)

  /// The event's finance report: the team edits while OPEN/RETURNED, then
  /// submits it once; the Events VP approves or returns it.
  financeStatus        FinanceReportStatus @default(OPEN)
  financeSubmittedAt   DateTime?
  financeSubmittedById String?
  financeSubmittedBy   User?               @relation("FinanceSubmittedBy", fields: [financeSubmittedById], references: [id])
  financeReviewedAt    DateTime?
  financeReviewedById  String?
  financeReviewedBy    User?               @relation("FinanceReviewedBy", fields: [financeReviewedById], references: [id])
  financeReviewNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FinanceReportStatus {
  OPEN
  SUBMITTED
  APPROVED
  RETURNED
}

/// One planned item of an event's budget. Shaped like a spreadsheet row so
/// budgets can be imported from Excel later (importBatchId groups an upload).
model EventBudgetLine {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  /// One of the standard categories (src/lib/finance/categories.ts).
  category      String
  item          String
  quantity      Decimal? @db.Decimal(10, 2)
  unitCost      Decimal? @db.Decimal(12, 2)
  plannedAmount Decimal  @db.Decimal(12, 2)
  note          String?
  sortOrder     Int      @default(0)
  importBatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

/// A ticket tier of an event. price 0 means free.
model TicketType {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  name        String
  description String?

  price       Decimal  @db.Decimal(10, 2)
  /// Null means no member discount.
  memberPrice Decimal? @db.Decimal(10, 2)

  /// Null means unlimited.
  capacity     Int?
  salesStartAt DateTime?
  salesEndAt   DateTime?
  membersOnly  Boolean   @default(false)
  maxPerOrder  Int       @default(1)

  color     String?
  perks     String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@index([eventId])
}

/// One checkout. Free orders have no Stripe session.
model Order {
  id      String  @id @default(cuid())
  eventId String
  event   Event   @relation(fields: [eventId], references: [id])
  userId  String?
  user    User?   @relation(fields: [userId], references: [id])

  buyerName  String
  buyerEmail String
  buyerPhone String?

  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  currency    String      @default("CAD")

  stripeSessionId String?   @unique
  paidAt          DateTime?

  waiverAcceptedAt DateTime?
  waiverVersion    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@index([eventId])
  @@index([userId])
  @@index([buyerEmail])
}

/// One entry pass per attendee; token is the QR code value.
model Ticket {
  id           String     @id @default(cuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id])
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id])
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  userId       String?
  user         User?      @relation("TicketHolder", fields: [userId], references: [id])

  holderName  String
  holderEmail String?

  token  String       @unique
  status TicketStatus @default(RESERVED)

  pricePaid     Decimal @db.Decimal(10, 2)
  memberPricing Boolean @default(false)

  checkedInAt   DateTime?
  checkedInById String?
  checkedInBy   User?     @relation("TicketCheckedInBy", fields: [checkedInById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([orderId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Members & Organization
//
// Membership replaces "ROCSAUT Membership Info" (frozen; its rows are copied
// here with source IMPORTED). Group replaces the flat Department table, which
// is left in place unused.
// ─────────────────────────────────────────────────────────────────────────────

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MembershipSource {
  STRIPE
  IMPORTED
  MANUAL
  COMPLIMENTARY
}

/// Highest first. Club membership is separate (Membership), not a position.
enum GroupPosition {
  PRESIDENT
  VP
  STAFF
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Details collected once and reused to pre-fill registrations.
/// Required fields are enforced by the profile form, so partial saves work.
model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone         String?
  studentNumber String?
  personalEmail String?
  program       String?
  yearOfStudy   String?

  /// Set when the "complete your profile" form is submitted.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per member per term (Sep 1 – Aug 31), so renewals keep history.
model Membership {
  id String @id @default(cuid())

  /// Null for imported members until they first log in with a matching email.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])
  email  String?
  name   String?

  /// OTSA-<year>-0xxx for members, OTSA-<year>-1xxx for staff.
  memberCode String @unique

  status    MembershipStatus @default(PENDING)
  source    MembershipSource
  termStart DateTime
  termEnd   DateTime

  stripeSessionId String?  @unique
  amountPaid      Decimal? @db.Decimal(10, 2)

  /// id of the copied "ROCSAUT Membership Info" row; makes the copy re-runnable.
  legacyId String? @unique

  /// Pass2U wallet pass, once issued (Phase 3).
  walletPassId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
}

/// A department (no parent) or a subgroup. Event teams link to their event.
model Group {
  id   String @id @default(cuid())
  name String
  slug String @unique

  parentId String?
  parent   Group?  @relation("GroupTree", fields: [parentId], references: [id])
  children Group[] @relation("GroupTree")

  eventId String? @unique
  event   Event?  @relation(fields: [eventId], references: [id])

  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members GroupMember[]

  @@index([parentId])
}

model GroupMember {
  id       String        @id @default(cuid())
  groupId  String
  group    Group         @relation(fields: [groupId], references: [id])
  userId   String
  user     User          @relation(fields: [userId], references: [id])
  position GroupPosition @default(STAFF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([userId])
}

/// A destructive action waiting for a second person (rules live in code).
model ApprovalRequest {
  id       String @id @default(cuid())
  /// e.g. "event.delete"
  action   String
  targetId String
  /// Snapshot of what will be affected, shown to the approver.
  details  Json?

  requestedById    String
  requestedBy      User          @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approverPosition GroupPosition @default(PRESIDENT)

  status      ApprovalStatus @default(PENDING)
  decidedById String?
  decidedBy   User?          @relation("ApprovalDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([action, targetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Discussions
// ─────────────────────────────────────────────────────────────────────────────

model Discussion {
  id          String     @id @default(cuid())
  eventId     String?    @unique
  event       Event?     @relation(fields: [eventId], references: [id])
  taskGroupId String?
  taskGroup   TaskGroup? @relation(fields: [taskGroupId], references: [id])
  createdAt   DateTime   @default(now())

  comments Comment[]
}

model Comment {
  id           String     @id @default(cuid())
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id])
  authorId     String?
  author       User?      @relation(fields: [authorId], references: [id])
  content      String
  isAnonymous  Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Announcements
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id        String             @id @default(cuid())
  title     String
  content   String
  published Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  authorId  String
  author    User               @relation(fields: [authorId], references: [id])
  reads     AnnouncementRead[]
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Task Groups
// ─────────────────────────────────────────────────────────────────────────────

model TaskGroup {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      TaskGroupStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdById String
  createdBy   User   @relation("TaskGroupCreator", fields: [createdById], references: [id])

  members     TaskGroupMember[]
  tasks       Task[]
  discussions Discussion[]
  votes       Vote[]
}

model TaskGroupMember {
  id          String        @id @default(cuid())
  taskGroupId String
  taskGroup   TaskGroup     @relation(fields: [taskGroupId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  role        TaskGroupRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  @@unique([taskGroupId, userId])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  taskGroupId String
  taskGroup   TaskGroup @relation(fields: [taskGroupId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  assignees TaskAssignee[]

  status TaskStatus @default(TODO)
  dueAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  views TaskView[]
}

model TaskAssignee {
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([taskId, userId])
}

model TaskView {
  id       String   @id @default(cuid())
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([taskId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Voting
// ─────────────────────────────────────────────────────────────────────────────

model Vote {
  id          String    @id @default(cuid())
  title       String
  description String?
  taskGroupId String
  taskGroup   TaskGroup @relation(fields: [taskGroupId], references: [id])

  createdById String
  createdBy   User   @relation("VoteCreator", fields: [createdById], references: [id])

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  options VoteOption[]
}

model VoteOption {
  id     String @id @default(cuid())
  voteId String
  vote   Vote   @relation(fields: [voteId], references: [id])
  label  String

  responses VoteResponse[]
}

model VoteResponse {
  id           String     @id @default(cuid())
  voteOptionId String
  voteOption   VoteOption @relation(fields: [voteOptionId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([voteOptionId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Sponsors
// ─────────────────────────────────────────────────────────────────────────────

model Sponsor {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  website     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  histories SponsorHistory[]
}

model SponsorHistory {
  id        String   @id @default(cuid())
  sponsorId String
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  year      Int
  tier      String
  createdAt DateTime @default(now())

  @@unique([sponsorId, year])
}

// ─────────────────────────────────────────────────────────────────────────────
// Site / Content
// ─────────────────────────────────────────────────────────────────────────────

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  year        Int
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Alumni {
  id             String   @id @default(cuid())
  name           String
  graduationYear Int?
  position       String?
  department     String?
  bio            String?
  linkedinUrl    String?
  instagramUrl   String?
  photoUrl       String?
  isPublic       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Finance
// ─────────────────────────────────────────────────────────────────────────────

model FinanceRecord {
  id          String      @id @default(cuid())
  type        FinanceType
  amount      Decimal     @db.Decimal(12, 2)
  currency    String      @default("CAD")
  category    String
  description String?
  date        DateTime

  createdById String
  createdBy   User   @relation("FinanceRecordCreator", fields: [createdById], references: [id])

  /// Set for an event's income and costs; null for club-wide entries.
  eventId       String?
  event         Event?  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  receiptUrl    String?
  importBatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model Budget {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("CAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, category])
}

// ─────────────────────────────────────────────────────────────────────────────
// Configuration / Email / Push
// ─────────────────────────────────────────────────────────────────────────────

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  key       String   @id
  subject   String
  body      String   @db.Text
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String?  @unique
  p256dh    String?
  auth      String?
  expoToken String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// ROCSAUT Membership
// ─────────────────────────────────────────────────────────────────────────────

model ROCSAUT_Membership_Info {
  id             String    @id @db.Uuid
  member_code    String
  name           String?
  email          String?
  personal_email String?
  student_number String?
  created_at     DateTime? @db.Timestamptz(6)
  year_of_study  String?
  role           String?

  @@map("ROCSAUT Membership Info")
}
